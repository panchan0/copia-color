{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "copias-color",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "copias-color-db",
      "database_id": "bbe14930-bca0-4ab1-b5f6-525b0011f9fe",
      "migrations_dir": "migrations"
    }
  ],
  "vars": {
    // "false" para impedir que se creen cuentas nuevas desde la página
    "ALLOW_SIGNUP": "false",
    // Iteraciones PBKDF2 para las contraseñas
    "PBKDF2_ITERATIONS": "60000",
    // Período de prueba de 15 días (desde el 27/11/2026). Al pagar se deja vacío: ""
    "PRUEBA_HASTA": "2026-12-12T23:59:59-05:00"
  },
  // Inteligencia artificial de Cloudflare para contestar los mensajes de WhatsApp y correo
  "ai": { "binding": "AI" },
  "version_metadata": { "binding": "CF_VERSION_METADATA" },
  "observability": { "enabled": true }
}
