{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "copias-color",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "copias-color-db",
      "database_id": "bbe14930-bca0-4ab1-b5f6-525b0011f9fe",
      "migrations_dir": "migrations"
    }
  ],
  "vars": {
    // "false" para impedir que se creen cuentas nuevas desde la página
    "ALLOW_SIGNUP": "false",
    // Iteraciones PBKDF2 para las contraseñas
    "PBKDF2_ITERATIONS": "60000"
  },
  "observability": { "enabled": true }
}
